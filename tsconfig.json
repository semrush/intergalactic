{
  "compilerOptions": {
    "module": "esnext",
    "target": "esnext",
    "lib": ["dom", "ESNext"],
    "jsx": "react",
    "declaration": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": false,
    "sourceMap": true,
    "importHelpers": false,
    "noEmitHelpers": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["node", "vitest", "@workspace/types/deps", "@workspace/types/globals", "@workspace/types/styles", "@workspace/types/vite"],
    "paths": {
      "@semcore/illustration/*": ["${configDir}/semcore/illustration/lib/*"],
      "@semcore/illustration": ["${configDir}/semcore/illustration"],
      "@semcore/icon/*": ["${configDir}/semcore/icon/lib/*"],
      "@semcore/ui/d3-chart": ["${configDir}/semcore/d3-chart"],
      "@semcore/ui/core/lib/*": ["${configDir}/semcore/core/src/*"],
      "@semcore/ui/*": ["${configDir}/semcore/*/src"],
      "@semcore/*": ["${configDir}/semcore/*/src"],
      "@tools/*": ["${configDir}/tools/*"]
    }
  },
  "files": [],
  "include": [],
  "references": [
    {"path": "./semcore/accordion"},
    {"path": "./semcore/add-filter"},
    {"path": "./semcore/badge"},
    {"path": "./semcore/base-components"},
    {"path": "./semcore/base-trigger"},
    {"path": "./semcore/breadcrumbs"},
    {"path": "./semcore/bulk-textarea"},
    {"path": "./semcore/button"},
    {"path": "./semcore/card"},
    {"path": "./semcore/carousel"},
    {"path": "./semcore/checkbox"},
    {"path": "./semcore/color-picker"},
    {"path": "./semcore/core"},
    {"path": "./semcore/counter"},
    {"path": "./semcore/d3-chart"},
    {"path": "./semcore/data-table"},
    {"path": "./semcore/date-picker"},
    {"path": "./semcore/divider"},
    {"path": "./semcore/dot"},
    {"path": "./semcore/drag-and-drop"},
    {"path": "./semcore/dropdown"},
    {"path": "./semcore/dropdown-menu"},
    {"path": "./semcore/ellipsis"},
    {"path": "./semcore/errors"},
    {"path": "./semcore/feature-highlight"},
    {"path": "./semcore/feature-popover"},
    {"path": "./semcore/feedback-form"},
    {"path": "./semcore/flags"},
    {"path": "./semcore/fullscreen-modal"},
    {"path": "./semcore/icon"},
    {"path": "./semcore/inline-edit"},
    {"path": "./semcore/inline-input"},
    {"path": "./semcore/input"},
    {"path": "./semcore/input-mask"},
    {"path": "./semcore/input-number"},
    {"path": "./semcore/input-tags"},
    {"path": "./semcore/link"},
    {"path": "./semcore/mini-chart"},
    {"path": "./semcore/modal"},
    {"path": "./semcore/notice"},
    {"path": "./semcore/notice-bubble"},
    {"path": "./semcore/pagination"},
    {"path": "./semcore/pills"},
    {"path": "./semcore/product-head"},
    {"path": "./semcore/progress-bar"},
    {"path": "./semcore/radio"},
    {"path": "./semcore/select"},
    {"path": "./semcore/side-panel"},
    {"path": "./semcore/skeleton"},
    {"path": "./semcore/slider"},
    {"path": "./semcore/spin"},
    {"path": "./semcore/spin-container"},
    {"path": "./semcore/switch"},
    {"path": "./semcore/tab-line"},
    {"path": "./semcore/tab-panel"},
    {"path": "./semcore/tag"},
    {"path": "./semcore/textarea"},
    {"path": "./semcore/time-picker"},
    {"path": "./semcore/tooltip"},
    {"path": "./semcore/typography"},
    {"path": "./semcore/widget-empty"},
    {"path": "./semcore/wizard"}
  ],
  "exclude": [
    "node_modules",
    "tools/icon-transform-svg/__tests__"
  ]
}
