{
  "compilerOptions": {
    "module": "esnext",
    "target": "esnext",
    "lib": ["dom", "es2019"],
    "jsx": "react",
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": false,
    "sourceMap": true,
    "importHelpers": false,
    "noEmitHelpers": true,
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "baseUrl": "./semcore",
    "typeRoots": ["node_modules/@types", "tools/@types"],
    "paths": {
      "@semcore/ui/illustration/*": ["illustration/*"],
      "@semcore/ui/icon/*": ["icon/*"],
      "@semcore/ui/d3-chart": ["d3-chart"],
      "@semcore/ui/core/lib/*": ["core/src/*"],
      "@semcore/ui/*": ["*/src"],
      "@tools/*": ["../tools/*"]
    }
  },
  "project": ["./semcore/*/tsconfig.json", "./tools/*/tsconfig.json"],
  "include": ["semcore", "tools", "stories", "playground"],
  "exclude": [
    "node_modules",
    "tools/icon-transform-svg/__tests__"
  ]
}
