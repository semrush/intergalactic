{
  "name": "@semcore/theme",
  "description": "Semrush Theme package",
  "version": "1.0.0",
  "author": "UI-kit team <ui-kit-team@semrush.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node --experimental-transform-types src/processor.ts",
    "check": "node --experimental-transform-types src/checker.ts"
  },
  "exports": {
    "./light.css": "./lib/light.css",
    "./dark.css": "./lib/dark.css",
    "./highlights-light.css": "./lib/highlights-light.css",
    "./highlights-dark.css": "./lib/highlights-dark.css",
    "./light": {
      "types": "./lib/light.ts",
      "import": "./lib/light.ts",
      "require": "./lib/light.ts"
    },
    "./lib/light": {
      "types": "./lib/light.ts",
      "import": "./lib/light.ts",
      "require": "./lib/light.ts"
    },
    "./dark": {
      "types": "./lib/dark.ts",
      "import": "./lib/dark.ts",
      "require": "./lib/dark.ts"
    },
    "./highlights-light": {
      "types": "./lib/highlights-light.ts",
      "import": "./lib/highlights-light.ts",
      "require": "./lib/highlights-light.ts"
    },
    "./highlights-dark": {
      "types": "./lib/highlights-dark.ts",
      "import": "./lib/highlights-dark.ts",
      "require": "./lib/highlights-dark.ts"
    },
    "./panda-preset": {
      "types": "./lib/panda-preset.ts",
      "import": "./lib/panda-preset.ts",
      "require": "./lib/panda-preset.ts"
    }
  },
  "dependencies": {},
  "peerDependencies": {},
  "repository": {
    "type": "git",
    "url": "https://github.com/semrush/intergalactic.git",
    "directory": "tools/theme"
  },
  "devDependencies": {
    "colorjs.io": "0.6.1",
    "postcss": "8.4.33",
    "postcss-value-parser": "4.1.0",
    "@pandacss/dev": "1.9.0",
    "@semcore/testing-utils": "workspace:*"
  }
}
